<UserControl x:Class="PoE_Price_Tracking.views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <StackPanel Width="300">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                <TextBlock Text="League:" 
                           FontSize="14" 
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <ComboBox x:Name="LeagueComboBox"
                          Width="130"
                          Padding="8,4"
                          FontSize="13"
                          SelectionChanged="LeagueComboBox_SelectionChanged">
                    <ComboBoxItem Content="Standard"/>
                    <ComboBoxItem Content="Hardcore"/>
                    <ComboBoxItem Content="Mirage"/>
                </ComboBox>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>