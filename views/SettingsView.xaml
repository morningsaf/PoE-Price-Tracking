<UserControl x:Class="PoE_Price_Tracking.views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <StackPanel Width="300">
            <TextBlock Text="League" FontSize="14" Margin="0,0,0,8"/>
            <ComboBox x:Name="LeagueComboBox"
                      Padding="8,4"
                      FontSize="13"
                      SelectionChanged="LeagueComboBox_SelectionChanged">
                <ComboBoxItem Content="Standard"/>
                <ComboBoxItem Content="Hardcore"/>
                <ComboBoxItem Content="Mirage"/>
            </ComboBox>
        </StackPanel>
    </Grid>
</UserControl>