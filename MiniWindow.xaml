<Window x:Class="PoE_Price_Tracking.MiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gif="http://wpfanimatedgif.codeplex.com"
        xmlns:local="clr-namespace:PoE_Price_Tracking"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="PoE Price Tracking"
        Width="250"
        Height="150"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        MinWidth="250"
        MinHeight="110"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            CornerRadius="8"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <local:StringToImageSourceConverter x:Key="StringToImage"/>
        <Style TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="9"/>
        </Style>
    </Window.Resources>

    <Border Background="White"
            CornerRadius="8"
            BorderBrush="#E0E0E0"
            BorderThickness="1">
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Width="17"
                        Height="17"
                        Click="Refresh_Click"
                        ToolTip="Refresh prices"
                        Style="{StaticResource PanelButton}">
                    <Image Source="assets/images/icons/refresh.png"
                           Width="16"
                           Height="16"
                           Stretch="Uniform"/>
                </Button>
                <Button Width="17"
                        Height="17"
                        Click="Restore_Click"
                        ToolTip="Maximize window"
                        Style="{StaticResource PanelButton}"
                        Margin="4,0,4,0">
                    <Image Source="assets/images/icons/maximize.png"
                           Width="16"
                           Height="16"
                           Stretch="Uniform"/>
                </Button>
            </StackPanel>

            <Border Grid.Row="1"
                    Background="#FAFAFA"
                    BorderBrush="#E0E0E0"
                    BorderThickness="0,0,0,1"
                    Margin="-8,0,-8,6">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="League:"
                               Foreground="#888"
                               Margin="4,0,4,0"/>
                    <TextBlock x:Name="StatusLeague"
                               Text="Standard"
                               FontWeight="SemiBold"
                               Foreground="#C8A84E"/>
                    <TextBlock Text="Status:"  
                               Foreground="#888"
                               Margin="12,0,6,0"/>
                    <TextBlock x:Name="StatusParser" 
                               Text="OK"
                               Foreground="Green"/>
                </StackPanel>
            </Border>

            <DataGrid x:Name="MiniTable"
                      Grid.Row="2"
                      AutoGenerateColumns="False"
                      HeadersVisibility="None"
                      GridLinesVisibility="None"
                      BorderThickness="0"
                      Background="White"
                      RowHeight="32"
                      Margin="-4,0,-4,0"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsHitTestVisible="True"
                      Focusable="False"
                      ScrollViewer.VerticalScrollBarVisibility="Hidden">
                <DataGrid.Resources>
                    <Style TargetType="DataGridCell">
                        <Setter Property="FocusVisualStyle"
                                Value="{x:Null}"/>
                        <Setter Property="BorderThickness"
                                Value="0"/>
                        <Setter Property="Padding"
                                Value="0"/>
                        <Setter Property="IsHitTestVisible"
                                Value="True"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="Transparent"
                                            BorderThickness="0">
                                        <ContentPresenter/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style TargetType="DataGridRow">
                        <Setter Property="IsHitTestVisible"
                                Value="False"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>

                    <DataGridTemplateColumn Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"
                                           FontSize="12"
                                           VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Image gif:ImageBehavior.AnimatedSource="pack://application:,,,/assets/loading.gif"
                                           Width="32"
                                           Height="32"
                                           HorizontalAlignment="Right">
                                           <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="RenderTransform">
                                                        <Setter.Value>
                                                            <TranslateTransform X="0" Y="0"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLoading}" Value="False">
                                                            <Setter Property="RenderTransform">
                                                                <Setter.Value>
                                                                    <TranslateTransform X="1000" Y="0"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                    </Image>
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Right">
                                        <TextBlock VerticalAlignment="Center"
                                                   Margin="0,0,4,0"
                                                   FontSize="12">
                                            <Run Text="{Binding TrendText}"
                                                 Foreground="{Binding TrendColor}"/>
                                            <Run Text=" "/>
                                            <Run Text="{Binding AmountText}"/>
                                        </TextBlock>
                                        <Image Source="{Binding CurrencyIcon, Converter={StaticResource StringToImage}}" 
                                            Width="20" Height="20"
                                            Stretch="Uniform"
                                            VerticalAlignment="Center">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CurrencyIcon}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</Window>