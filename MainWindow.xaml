<Window x:Class="PoE_Price_Tracking.MainWindow"
        xmlns:local="clr-namespace:PoE_Price_Tracking"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:views="clr-namespace:PoE_Price_Tracking.views"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="PoE Price Tracking"
        Width="1000" Height="800"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="{DynamicResource PrimaryBackgroundBrush}" 
            CornerRadius="12"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1,1,1,0"
            Padding="0,0,0,8">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  
                <RowDefinition Height="Auto"/> 
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>     
            </Grid.RowDefinitions>

            <!-- Заголовок окна -->
            <Border Grid.Row="0"
                    Background="{DynamicResource TitleBarBackgroundBrush}"
                    Padding="12,8"
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="Window_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" 
                               Text="PoE Price Tracker"
                               FontFamily="assets/fonts/PlayfairDisplay-VariableFont_wght.ttf#Playfair Display"
                               FontSize="15" FontWeight="Bold"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="─" Width="28" Height="28"
                                FontSize="12"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="MinimizeWindow_Click"/>
                        <Button Content="✕" Width="28" Height="28"
                                FontSize="12"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="CloseWindow_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Панель инструментов -->
            <Border Grid.Row="1" 
                    Background="{DynamicResource SecondaryBackgroundBrush}"
                    Padding="8,4"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Width="33" Height="33"
                        Padding="0"
                        Margin="4,0,4,0"
                        ToolTip="Toggle theme"
                        Click="ToggleTheme_Click"
                        Style="{StaticResource PanelButton}">
                    <TextBlock x:Name="ThemeIconText" 
                                Text = ""
                                FontFamily="assets/fonts/Roboto-VariableFont_wdth,wght.ttf#Roboto"
                                FontSize="16" 
                                VerticalAlignment="Center" 
                                HorizontalAlignment="Center"/>
                    </Button>
                    <Button Width="33" Height="33"
                            Padding="0"
                            Margin="4,0,4,0"
                            ToolTip="Refresh prices"
                            Click="RefreshPrices_Click"
                            Style="{StaticResource PanelButton}">
                        <TextBlock Text="⟳" FontSize="30" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                    <Button Width="33" Height="33"
                            Padding="0"
                            Margin="4,0,4,0"
                            ToolTip="Minimize window"
                            Click="Minimize_Click"
                            Style="{StaticResource PanelButton}">
                        <TextBlock Text="⇣" FontSize="30" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                    <Button Width="33" Height="33"
                            Padding="0"
                            Margin="4,0,4,0"
                            ToolTip="Info"
                            Style="{StaticResource PanelButton}">
                        <TextBlock Text="🛈" FontSize="30" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Статус-бар -->
            <Border Grid.Row="2" 
                    Background="{DynamicResource StatusBarBackgroundBrush}"
                    Padding="8,4"
                    BorderBrush="{DynamicResource StatusBarBorderBrush}"
                    BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="League:" 
                               FontSize="12" 
                               Foreground="#888"
                               Margin="0,0,4,0"/>
                    <TextBlock x:Name="StatusLeague" 
                               Text="Standard"
                               FontSize="12" 
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"
                               Margin="0,0,20,0"/>
                    <TextBlock Text="Status:" 
                               FontSize="12" 
                               Foreground="#888"
                               Margin="0,0,4,0"/>
                    <TextBlock x:Name="StatusParser" 
                               Text="OK"
                               FontSize="12"
                               Foreground="Green"/>
                </StackPanel>
            </Border>

            <!-- Вкладки -->
            <Border Grid.Row="3"
                    CornerRadius="0,0,12,12"
                    Background="{DynamicResource PrimaryBackgroundBrush}"
                    ClipToBounds="True">
                <TabControl Background="Transparent"
                            BorderThickness="0">
                    <TabControl.Resources>
                        <Style TargetType="TabPanel">
                            <Setter Property="Margin" Value="0,0,0,0"/>
                        </Style>
                    </TabControl.Resources>
                    <TabItem Header="General">
                        <views:GeneralView x:Name="GeneralViewControl"/>
                    </TabItem>
                    <TabItem Header="Select Items">
                        <views:ItemCatalogView x:Name="ItemCatalogView"/>
                    </TabItem>
                    <TabItem Header="Settings">
                        <views:SettingsView x:Name="SettingsViewControl"/>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Border>
</Window>
