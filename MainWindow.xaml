<Window x:Class="PoE_Price_Tracking.MainWindow"
        xmlns:local="clr-namespace:PoE_Price_Tracking"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:views="clr-namespace:PoE_Price_Tracking.views"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:gif="http://wpfanimatedgif.codeplex.com"
        Title="PoE Price Tracking"
        Width="1000" Height="800"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">
    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style TargetType="Button">
            <Setter Property="Background" Value="WhiteSmoke"/>
            <Setter Property="BorderBrush" Value="LightGray"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#C8DCFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="White" 
            CornerRadius="12"
            BorderBrush="#E0E0E0"
            BorderThickness="1"
            Padding="0,0,0,8">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  
                <RowDefinition Height="Auto"/> 
                <RowDefinition Height="*"/>     
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#F0F0F0"
                    Padding="12,8"
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="Window_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" 
                               Text="PoE Price Tracking"
                               FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="─" Width="28" Height="28"
                                FontSize="12"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="MinimizeWindow_Click"/>
                        <Button Content="✕" Width="28" Height="28"
                                FontSize="12"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="CloseWindow_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" 
                    Background="#F5F5F5"
                    Padding="8,4"
                    BorderBrush="#E0E0E0"
                    BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal">
                    <Button Content="⟳" Width="28" Height="28"
                            Margin="0,0,4,0"
                            ToolTip="Обновить цены"
                            Click="RefreshPrices_Click"/>
                    <Button Content="▢" Width="28" Height="28"
                            Margin="0,0,4,0"
                            ToolTip="Свернуть в мини-окно"/>
                    <Button Content="👤" Width="28" Height="28"
                            Margin="0,0,4,0"
                            ToolTip="Аккаунт"/>
                    <Button Content="?" Width="28" Height="28"
                            ToolTip="Справка"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="2"
                    CornerRadius="0,0,12,12"
                    Background="White"
                    ClipToBounds="True">
                <TabControl Background="Transparent"
                            BorderThickness="0">
                    <TabControl.Resources>
                        <Style TargetType="TabPanel">
                            <Setter Property="Margin" Value="0,0,0,0"/>
                        </Style>
                    </TabControl.Resources>
                    <TabItem Header="General">
                        <views:GeneralView x:Name="GeneralViewControl"/>
                    </TabItem>
                    <TabItem Header="Choose Items">
                        <views:ItemCatalogView x:Name="ItemCatalogView"/>
                    </TabItem>
                    <TabItem Header="Settings">
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Border>
</Window>
